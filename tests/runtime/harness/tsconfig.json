{
  // Type check of the harness runner scripts: `npx tsc -p tests/runtime/harness` (CI and local).
  // `npm run check` (svelte-check) reads .js and .ts only, so these .mjs files were never
  // checked. They are plain JavaScript typed by comments; this makes the comments count.
  // Not `strict`: the files are not annotated for implicit `any`, but a wrong property, a
  // missing name, a call with the wrong arguments or a wrong comment type fails here.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["*.mjs", "ambient.d.mts"]
}
