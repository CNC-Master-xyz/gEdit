0 BEGIN PGM EXP4 MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 TOOL CALL 1 Z S3000
3 L Z+100 R0 FMAX M3
4 CYCL DEF 200 DRILLING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-10 ;DEPTH ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q202=5 ;PLUNGING DEPTH ~
  Q210=0 ;DWELL TIME AT TOP ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE ~
  Q211=0.5 ;DWELL TIME AT DEPTH ~
  Q395=0 ;DEPTH REFERENCE
5 L X+10 Y+10 R0 FMAX M99
6 CYCL DEF 206 TAPPING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-12 ;DEPTH OF THREAD ~
  Q206=750 ;FEED RATE FOR PLNGNG ~
  Q211=0 ;DWELL TIME AT DEPTH ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE
7 L X+30 Y+10 R0 FMAX M99
8 CYCL DEF 203 UNIVERSAL DRILLING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-20 ;DEPTH ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q202=5 ;PLUNGING DEPTH ~
  Q210=0 ;DWELL TIME AT TOP ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE ~
  Q212=1 ;DECREMENT ~
  Q213=2 ;BREAKS ~
  Q205=3 ;MIN. PLUNGING DEPTH ~
  Q211=0.5 ;DWELL TIME AT DEPTH ~
  Q208=500 ;RETRACTION FEED RATE ~
  Q256=0.5 ;DIST FOR CHIP BRKNG ~
  Q395=0 ;DEPTH REFERENCE
9 L X+50 Y+10 R0 FMAX M99
10 CYCL DEF 201 REAMING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-15 ;DEPTH ~
  Q206=0 ;FEED RATE FOR PLNGNG ~
  Q211=0 ;DWELL TIME AT DEPTH ~
  Q208=0 ;RETRACTION FEED RATE ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE
11 L X+70 Y+10 R0 FMAX M99
12 L Z+100 R0 FMAX M30
13 END PGM EXP4 MM
