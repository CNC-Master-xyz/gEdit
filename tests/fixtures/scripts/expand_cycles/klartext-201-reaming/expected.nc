0 BEGIN PGM EXP5 MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 BLK FORM 0.1 Z X+0 Y+0 Z-20
3 BLK FORM 0.2 X+100 Y+100 Z+0
4 TOOL CALL 3 Z S800
5 L Z+100 R0 FMAX M3
6 CYCL DEF 201 REAMING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-15 ;DEPTH ~
  Q206=100 ;FEED RATE FOR PLNGNG ~
  Q211=0.5 ;DWELL TIME AT DEPTH ~
  Q208=250 ;RETRACTION FEED RATE ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE
7 L X+30 Y+20 R0 FMAX
8 L Z+2 FMAX
9 L Z-15 F100
10 CYCL DEF 9.0 DWELL TIME
11 CYCL DEF 9.1 DWELL 0.5
12 L Z+2 F250
13 L Z+50 FMAX
14 CYCL DEF 200 DRILLING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-10 ;DEPTH ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q202=4 ;PLUNGING DEPTH ~
  Q210=0 ;DWELL TIME AT TOP ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE ~
  Q211=0.0 ;DWELL TIME AT DEPTH ~
  Q395=+0 ;DEPTH REFERENCE
15 L X+60 Y+20 R0 FMAX
16 L Z+2 FMAX
17 L Z-4 F150
18 L Z+2 FMAX
19 L Z-2 FMAX
20 L Z-8
21 L Z+2 FMAX
22 L Z-6 FMAX
23 L Z-10
24 L Z+50 FMAX
25 L Z+100 R0 FMAX M30
26 END PGM EXP5 MM
