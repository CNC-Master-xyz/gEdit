0 BEGIN PGM EXP1 MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 BLK FORM 0.1 Z X+0 Y+0 Z-20
3 BLK FORM 0.2 X+100 Y+100 Z+0
4 TOOL CALL 1 Z S3000
5 L Z+100 R0 FMAX M3
6 L X+10 Y+10 R0 FMAX
7 L Z+50 F500
8 CYCL DEF 200 DRILLING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-12 ;DEPTH ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q202=5 ;PLUNGING DEPTH ~
  Q210=0 ;DWELL TIME AT TOP ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE ~
  Q211=0 ;DWELL TIME AT DEPTH ~
  Q395=0 ;DEPTH REFERENCE
9 L X+20 Y+20 R0 FMAX M99
10 CYCL CALL POS X+40 Y+40 Z-2 FMAX
11 L X+60 Y+60 R0 FMAX M89
12 L X+70 Y+60 R0 FMAX
13 L X+80 Y+60 R0 FMAX M99
14 L X+90 Y+90 R0
15 L Z+100 R0 FMAX
16 L X+0 Y+0 F800
17 CYCL CALL
18 L Z+100 R0 FMAX M30
19 END PGM EXP1 MM
