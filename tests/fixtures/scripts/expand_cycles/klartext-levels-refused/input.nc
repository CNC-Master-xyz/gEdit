0 BEGIN PGM LEVELS MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 TOOL CALL 3 Z S800
3 L Z+100 R0 FMAX M3
4 CYCL DEF 200 DRILLING ~
  Q200=-2 ;SET-UP CLEARANCE ~
  Q201=-15 ;DEPTH ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q202=5 ;PLUNGING DEPTH ~
  Q210=0 ;DWELL TIME AT TOP ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE ~
  Q211=0 ;DWELL TIME AT DEPTH ~
  Q395=0 ;DEPTH REFERENCE
5 L X+10 Y+10 R0 FMAX M99
6 L Z+100 R0 FMAX
7 CYCL DEF 200 DRILLING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-15 ;DEPTH ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q202=5 ;PLUNGING DEPTH ~
  Q210=0 ;DWELL TIME AT TOP ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=-5 ;2ND SET-UP CLEARANCE ~
  Q211=0 ;DWELL TIME AT DEPTH ~
  Q395=0 ;DEPTH REFERENCE
8 L X+20 Y+10 R0 FMAX M99
9 L Z+100 R0 FMAX
10 CYCL DEF 200 DRILLING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=0 ;DEPTH ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q202=5 ;PLUNGING DEPTH ~
  Q210=0 ;DWELL TIME AT TOP ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE ~
  Q211=0 ;DWELL TIME AT DEPTH ~
  Q395=0 ;DEPTH REFERENCE
11 L X+30 Y+10 R0 FMAX M99
12 L Z+100 R0 FMAX
13 CYCL DEF 200 DRILLING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=+1 ;DEPTH ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q202=5 ;PLUNGING DEPTH ~
  Q210=0 ;DWELL TIME AT TOP ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE ~
  Q211=0 ;DWELL TIME AT DEPTH ~
  Q395=0 ;DEPTH REFERENCE
14 L X+40 Y+10 R0 FMAX M99
15 L Z+100 R0 FMAX
16 M30
17 END PGM LEVELS MM
