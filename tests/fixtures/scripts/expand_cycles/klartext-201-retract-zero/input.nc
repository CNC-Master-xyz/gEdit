0 BEGIN PGM EXP9 MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 BLK FORM 0.1 Z X+0 Y+0 Z-20
3 BLK FORM 0.2 X+100 Y+100 Z+0
4 TOOL CALL 3 Z S800
5 L Z+100 R0 FMAX M3
6 CYCL DEF 201 REAMING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-15 ;DEPTH ~
  Q206=100 ;FEED RATE FOR PLNGNG ~
  Q211=0.5 ;DWELL TIME AT DEPTH ~
  Q208=0 ;RETRACTION FEED RATE ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE
7 L X+30 Y+20 R0 FMAX M99
8 L X+60 Y+20 R0 F500
9 CYCL DEF 201 REAMING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-15 ;DEPTH ~
  Q206=100 ;FEED RATE FOR PLNGNG ~
  Q211=0 ;DWELL TIME AT DEPTH ~
  Q208=+0.0 ;RETRACTION FEED RATE ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE
10 CYCL CALL
11 L Z+100 R0 FMAX M30
12 END PGM EXP9 MM
