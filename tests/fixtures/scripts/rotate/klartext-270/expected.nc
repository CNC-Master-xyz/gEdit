4 L X+0 Y-10 R0 FMAX
5 L Z-1 F200
6 L X+5 Y-20 RL F300
7 CC X+15 Y-20
8 C X+15 Y-30 DR+
9 LP PR+10 PA+300
10 CP IPA+90 DR+
11 L IX+0 IY-5
12 L X+23.66 Y-40
13 L X-2.5 Y-40.0 R0
14 L Z+5 FMAX
15 CYCL DEF 200 BOHREN ~
  Q200=+2 ;SICHERHEITS-ABST. ~
  Q201=-10 ;TIEFE ~
  Q206=+150 ;VORSCHUB TIEFENZ. ~
  Q202=+5 ;ZUSTELL-TIEFE ~
  Q210=+0 ;VERWEILZEIT OBEN ~
  Q203=+0 ;KOOR. OBERFLAECHE ~
  Q204=+50 ;2. SICHERHEITS-ABST. ~
  Q211=+0 ;VERWEILZEIT UNTEN
16 L X+10 Y-50 FMAX M99
17 CYCL CALL POS X+10 Y-60 Z+0
18 L Z+100 R0 FMAX M91
19 END PGM SYNTH MM
