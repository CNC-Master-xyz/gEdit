0 BEGIN PGM SYNTH MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 TOOL CALL 1 Z S3000
3 L Z+5 R0 FMAX M3
4 L X+10 Y+10 R0 FMAX
5 L Z-1 F200
6 L X+20 Y+5 RR F300
7 CC X+20 Y-5
8 C X+30 Y-5 DR-
9 LP PR+10 PA-30
10 CP IPA-90 DR-
11 L IX+5
12 L X+40
13 L Y+7.5 R0
14 L Z+5 FMAX
15 CYCL DEF 200 BOHREN ~
  Q200=+2 ;SICHERHEITS-ABST. ~
  Q201=-10 ;TIEFE ~
  Q206=+150 ;VORSCHUB TIEFENZ. ~
  Q202=+5 ;ZUSTELL-TIEFE ~
  Q210=+0 ;VERWEILZEIT OBEN ~
  Q203=+0 ;KOOR. OBERFLAECHE ~
  Q204=+50 ;2. SICHERHEITS-ABST. ~
  Q211=+0 ;VERWEILZEIT UNTEN
16 L X+50 Y+0 FMAX M99
17 CYCL CALL POS X+60 Y+0 Z+0
18 L Z+100 R0 FMAX M91
19 END PGM SYNTH MM
