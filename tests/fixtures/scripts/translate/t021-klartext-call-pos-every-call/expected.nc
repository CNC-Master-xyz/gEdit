0 BEGIN PGM TR3 MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 BLK FORM 0.1 Z X+0 Y+0 Z-20
3 BLK FORM 0.2 X+100 Y+100 Z+0
4 TOOL CALL 1 Z S3000
5 L Z+100.5 R0 FMAX M3
6 CYCL DEF 200 DRILLING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q201=-10 ;DEPTH ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q202=5 ;PLUNGING DEPTH ~
  Q210=0 ;DWELL TIME AT TOP ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE ~
  Q211=0 ;DWELL TIME AT DEPTH ~
  Q395=0 ;DEPTH REFERENCE
7 CYCL CALL POS X+21 Y+20 Z+0.5 FMAX
8 CYCL CALL POS X+41 Y+20 Z-4.5 FMAX
9 CYCL CALL POS X+61 Y+20 Z+3.0 FMAX
10 L Z+100.5 R0 FMAX
11 L X+1 Y+0 R0 FMAX M30
12 END PGM TR3 MM
