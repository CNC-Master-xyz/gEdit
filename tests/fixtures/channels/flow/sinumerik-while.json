{
  "comment": "Written for gEdit (synthetic, not for a machine); see README.md here.",
  "description": "Siemens two channels: channel 1 waits on mark 1 inside WHILE R1<3 ... ENDWHILE; channel 2 writes it three times. A WHILE is never a counted loop: the count stays not checked, as before.",
  "rule": "F3 F5",
  "profile": "sinumerik",
  "preset": "sinumerik-2channel",
  "program": {
    "1": [
      "%_N_FLOWF1_MPF",
      "; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE",
      "R1=0",
      "WHILE R1<3",
      "NN100: WAITM(1,1,2)",
      "R1=R1+1",
      "ENDWHILE",
      "M30"
    ],
    "2": [
      "%_N_FLOWF2_MPF",
      "; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE",
      "NN100: WAITM(1,1,2)",
      "NN110: WAITM(1,1,2)",
      "NN120: WAITM(1,1,2)",
      "M30"
    ]
  },
  "expect": {
    "flow": {
      "1": {
        "jumps": [],
        "loops": [],
        "opaque": [
          4,
          7
        ]
      },
      "2": {
        "jumps": [],
        "loops": [],
        "opaque": []
      }
    },
    "before": [
      {
        "kind": "count-not-checked",
        "channel": "2",
        "line": 4,
        "mark": "1",
        "other": "1",
        "otherLine": 5,
        "counts": {
          "channel": 3,
          "other": 1
        }
      }
    ],
    "after": [
      {
        "kind": "count-not-checked",
        "channel": "2",
        "line": 4,
        "mark": "1",
        "other": "1",
        "otherLine": 5,
        "counts": {
          "channel": 3,
          "other": 1
        }
      }
    ]
  }
}
